# GEMINI_API_KEY: Required for Gemini AI API calls (optional).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"
PORT=3000

# Payment Gateway Adapter: "midtrans" (default) or "xendit"
PAYMENT_GATEWAY="midtrans"

# Midtrans Sandbox / Production Credentials (never expose Server Key to frontend)
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION="false"

# Xendit Alternative Adapter Credentials
XENDIT_SECRET_KEY=""
XENDIT_CALLBACK_TOKEN=""

# QRIS Configuration:
# MODE "B" = Real merchant static QRIS converted dynamically (tag 01=12, tag 54=amount, recomputed CRC)
# MODE "A" = Payment gateway dynamic QRIS API (falls back to Mode B real merchant QRIS if gateway keys are unset)
QRIS_MODE="B"
QRIS_UNIQUE_CODE="true"
QRIS_MERCHANT_NAME="ALSTOREE, KESEHATAN & OLAHRAGA"
QRIS_NMID="ID1026484173624"

# Real scanned merchant QRIS static sticker text (server-side only; validated at startup)
QRIS_STATIC_PAYLOAD="00020101021126610014COM.GO-JEK.WWW01189360091439188017080210G9188017080303UMI51440014ID.CO.QRIS.WWW0215ID10264841736240303UMI5204794153033605802ID5925AlStoree, Kesehatan & Ola6013JAKARTA TIMUR61051335062140703A01110362163040AE2"

# Admin Verification Console Secret (for /admin QRIS mutation matching & manual verification)
ADMIN_SECRET="lintasku-admin-sandbox-2026"
ADMIN_EMAILS="alfathadiputra24@gmail.com"
