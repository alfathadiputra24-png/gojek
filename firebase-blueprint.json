{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user account profile and demo wallet counters.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 160
        },
        "phone": {
          "type": "string",
          "maxLength": 32
        },
        "demoBalance": {
          "type": "number"
        },
        "demoPoints": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "displayName", "email", "demoBalance", "demoPoints", "createdAt", "updatedAt"]
    },
    "SavedAddress": {
      "title": "SavedAddress",
      "description": "User saved pickup or delivery location.",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "address": {
          "type": "string",
          "minLength": 3,
          "maxLength": 240
        },
        "lat": {
          "type": "number"
        },
        "lng": {
          "type": "number"
        },
        "isDefault": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["userId", "label", "address", "lat", "lng", "isDefault", "createdAt", "updatedAt"]
    },
    "OrderRecord": {
      "title": "OrderRecord",
      "description": "On-demand service order across ride, food, delivery, and shop.",
      "type": "object",
      "properties": {
        "orderId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "serviceType": {
          "type": "string",
          "enum": ["ojek", "taksi", "makan", "kirim", "belanja"]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 140
        },
        "status": {
          "type": "string",
          "enum": ["pending_payment", "waiting_verification", "pay_on_delivery", "finding_driver", "active", "arrived", "completed", "cancelled"]
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["qris", "ewallet", "cod"]
        },
        "paymentProvider": {
          "type": "string",
          "maxLength": 40
        },
        "subtotal": {
          "type": "number"
        },
        "discount": {
          "type": "number"
        },
        "fee": {
          "type": "number"
        },
        "total": {
          "type": "number"
        },
        "voucherCode": {
          "type": "string",
          "maxLength": 32
        },
        "pickupAddress": {
          "type": "string",
          "maxLength": 240
        },
        "dropoffAddress": {
          "type": "string",
          "maxLength": 240
        },
        "driverName": {
          "type": "string",
          "maxLength": 80
        },
        "rating": {
          "type": "number"
        },
        "tipAmount": {
          "type": "number"
        },
        "proofNote": {
          "type": "string",
          "maxLength": 200
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["orderId", "userId", "serviceType", "title", "status", "paymentMethod", "subtotal", "discount", "fee", "total", "createdAt", "updatedAt"]
    },
    "ChatConversation": {
      "title": "ChatConversation",
      "description": "Conversation thread with a driver or merchant.",
      "type": "object",
      "properties": {
        "conversationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "participantName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "participantRole": {
          "type": "string",
          "enum": ["driver", "merchant", "support"]
        },
        "lastMessage": {
          "type": "string",
          "maxLength": 300
        },
        "unreadCount": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["conversationId", "userId", "participantName", "participantRole", "lastMessage", "unreadCount", "createdAt", "updatedAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "Individual message inside a conversation thread.",
      "type": "object",
      "properties": {
        "conversationId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "senderRole": {
          "type": "string",
          "enum": ["user", "partner"]
        },
        "senderName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["conversationId", "userId", "senderRole", "senderName", "text", "createdAt"]
    },
    "BugReport": {
      "title": "BugReport",
      "description": "User-submitted issue report triggered via DeviceMotion shake or manual entry.",
      "type": "object",
      "properties": {
        "reportId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "category": {
          "type": "string",
          "enum": ["bug", "payment", "map", "performance", "other"]
        },
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "minLength": 5,
          "maxLength": 1000
        },
        "currentScreen": {
          "type": "string",
          "maxLength": 80
        },
        "deviceInfo": {
          "type": "string",
          "maxLength": 240
        },
        "triggerSource": {
          "type": "string",
          "enum": ["shake", "manual"]
        },
        "status": {
          "type": "string",
          "enum": ["open", "resolved"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["reportId", "userId", "category", "title", "description", "triggerSource", "status", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Owner-isolated user profile and demo wallet counters."
    },
    "/users/{userId}/addresses/{addressId}": {
      "schema": { "$ref": "#/entities/SavedAddress" },
      "description": "User saved addresses subcollection."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/OrderRecord" },
      "description": "Service orders owned by individual users."
    },
    "/conversations/{conversationId}": {
      "schema": { "$ref": "#/entities/ChatConversation" },
      "description": "User chat conversations with drivers and merchants."
    },
    "/conversations/{conversationId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Messages inside a user conversation."
    },
    "/bug_reports/{reportId}": {
      "schema": { "$ref": "#/entities/BugReport" },
      "description": "User issue reports triggered by Shake-to-Report accelerometer or manual form."
    }
  }
}
